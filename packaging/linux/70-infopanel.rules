# InfoPanel's USB panels: the user signed in at the computer's seat may use them (TAG+="uaccess": systemd-logind
# gives that user, and only that user, access to the device's node; never a world-writable mode). One line per USB id
# and transport a bundled panel driver matches: usb, the device node libusb opens; hid, its hidraw nodes; serial, its
# tty nodes. Only ids that are a panel's own: the generic ones some panels share with other devices (USB gadgets, a
# serial chip's own id) are in 70-infopanel-opt-in.rules, which a user copies to /etc/udev/rules.d to use them.
# packaging/linux/build.sh refuses to package a copy that isn't exactly what the drivers need, and prints the lines
# with --print-rules. Before 73-seat-late.rules, which applies the tag.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5302", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="264a", ATTRS{idProduct}=="2347", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="26ce", ATTRS{idProduct}=="0a10", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="33c3", ATTRS{idProduct}=="7788", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="33c3", ATTRS{idProduct}=="f101", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0416", ATTR{idProduct}=="5406", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0416", ATTR{idProduct}=="5408", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0416", ATTR{idProduct}=="5409", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="0016", TAG+="uaccess"
