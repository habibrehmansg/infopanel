Depends: libc6, libgcc-s1, libstdc++6, libicu78 | libicu77 | libicu76 | libicu75 | libicu74 | libicu72 | libicu70, libssl3t64 | libssl3, ca-certificates, libuuid1, libfreetype6, libfontconfig1, libusb-1.0-0, tzdata
Recommends: ffmpeg
Section: utils
