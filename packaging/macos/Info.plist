<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app bundle's Info.plist, a template: build.sh copies it into InfoPanel.app/Contents and sets
     CFBundleShortVersionString (the version's numeric part) and CFBundleVersion (the whole version) from its version
     argument. LSUIElement: a menu-bar app, no Dock icon. LSMinimumSystemVersion: the oldest macOS .NET 10 supports.
     CFBundleURLTypes: the infopanel: link, which opens the editor (nothing in the link is read). -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>InfoPanel</string>
	<key>CFBundleExecutable</key>
	<string>InfoPanel</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>net.infopanel.InfoPanel</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>InfoPanel</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>net.infopanel.InfoPanel</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>infopanel</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © Habib Rehman</string>
</dict>
</plist>
