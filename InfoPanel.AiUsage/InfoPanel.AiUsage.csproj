<Project Sdk="Microsoft.NET.Sdk">

  <!-- AI usage, a first-party plugin bundled with the engine (plugins/InfoPanel.AiUsage/, InfoPanel/InfoPanel.csproj's
       BundledPlugin list): Claude Code's and Codex's limits as readings, its readers on by default, the user turning either off
       (docs/2.0/ai-usage.md). A plugin like any other: it builds against the SDK, which the host hands it, so it carries
       no copy of its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>InfoPanel.AiUsage</AssemblyName>
    <RootNamespace>InfoPanel.AiUsage</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfoPanel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Plugins\InfoPanel.Plugins.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="PluginInfo.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
