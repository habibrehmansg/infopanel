<Project Sdk="Microsoft.NET.Sdk">

  <!-- The panel driver SDK: what a USB panel family implements (IPanelDriver, IPanelSession) and the records they pass.
       On net10.0, the engine's own runtime, unlike the sensor plugin SDK (net8.0); no dependency beyond the framework. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>InfoPanel.Panels.Sdk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfoPanel.Core.Tests" />
    <!-- The engine reads a package's panel.json as a driver does (ManifestFile: one handle, never through a link). -->
    <InternalsVisibleTo Include="InfoPanel.Core" />
  </ItemGroup>

</Project>
