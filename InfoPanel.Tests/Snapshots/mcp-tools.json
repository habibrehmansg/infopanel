            "items": {
              "type": "object",
              "properties": {
                "scene": {
                  "type": "object",
                  "description": "The item's scene (format infopanel.scene/1): get_design_guide topic scenes has the format."
                },
                "x": {
                  "type": "number",
                  "description": "The item's left edge in pixels: on the canvas, or from its group's x in a group (0 when absent).",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "y": {
                  "type": "number",
                  "description": "The item's top edge in pixels: on the canvas, or from its group's y in a group (0 when absent).",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "width": {
                  "type": "number",
                  "description": "The item's layout box width, for a scene that reads its box.",
                  "minimum": 0,
                  "maximum": 100000
                },
                "height": {
                  "type": "number",
                  "description": "The item's layout box height, for a scene that reads its box.",
                  "minimum": 0,
                  "maximum": 100000
                },
                "name": {
                  "type": "string",
                  "description": "The item's name, as the editor's layers show it.",
                  "minLength": 1,
                  "maxLength": 256
                },
                "bindings": {
                  "type": "object",
                  "description": "The scene's inputs bound to sensors: input name to a sensor key from list_sensors, or to {\"key\", \"stat\"}."
                },
                "group": {
                  "type": "string",
                  "description": "A group's id or exact name to add the item into (the top level when absent).",
                  "minLength": 1,
                  "maxLength": 256
                },
                "index": {
                  "type": "integer",
                  "description": "Where among its siblings, 0 first (the end, drawn on top, when absent).",
                  "minimum": 0,
                  "maximum": 2000
                },
                "children": {
                  "type": "array",
                  "description": "Makes this entry a group of these items, in drawing order: 0 to 50, each as an item here but without group, index or children; their x, y are from the group's x, y. A group takes name, x, y, group and index, never scene, width, height or bindings.",
                  "minItems": 0,
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "properties": {
                      "scene": {
                        "type": "object",
                        "description": "The item's scene (format infopanel.scene/1): get_design_guide topic scenes has the format."
                      },
                      "x": {
                        "type": "number",
                        "description": "The item's left edge in pixels: on the canvas, or from its group's x in a group (0 when absent).",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "y": {
                        "type": "number",
                        "description": "The item's top edge in pixels: on the canvas, or from its group's y in a group (0 when absent).",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "width": {
                        "type": "number",
                        "description": "The item's layout box width, for a scene that reads its box.",
                        "minimum": 0,
                        "maximum": 100000
                      },
                      "height": {
                        "type": "number",
                        "description": "The item's layout box height, for a scene that reads its box.",
                        "minimum": 0,
                        "maximum": 100000
                      },
                      "name": {
                        "type": "string",
                        "description": "The item's name, as the editor's layers show it.",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "bindings": {
                        "type": "object",
                        "description": "The scene's inputs bound to sensors: input name to a sensor key from list_sensors, or to {\"key\", \"stat\"}."
                      }
                    },
                    "required": [
                      "scene"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "profile",
          "items"
        ],
        "additionalProperties": false
      },
