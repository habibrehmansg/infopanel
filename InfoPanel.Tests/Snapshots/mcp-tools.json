            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "scene": {
                  "type": "object",
                  "description": "The item's scene (format infopanel.scene/1): get_design_guide topic scenes has the format."
                },
                "x": {
                  "type": "number",
                  "description": "The item's left edge on the canvas, in pixels (0 when absent).",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "y": {
                  "type": "number",
                  "description": "The item's top edge on the canvas, in pixels (0 when absent).",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "width": {
                  "type": "number",
                  "description": "The item's layout box width, for a scene that reads its box.",
                  "minimum": 0,
                  "maximum": 100000
                },
                "height": {
                  "type": "number",
                  "description": "The item's layout box height, for a scene that reads its box.",
                  "minimum": 0,
                  "maximum": 100000
                },
                "name": {
                  "type": "string",
                  "description": "The item's name, as the editor's layers show it.",
                  "minLength": 1,
                  "maxLength": 256
                },
                "bindings": {
                  "type": "object",
                  "description": "The scene's inputs bound to sensors: input name to a sensor key from list_sensors, or to {\"key\", \"stat\"}."
                },
                "group": {
                  "type": "string",
                  "description": "A group's id or exact name to add the item into (the top level when absent).",
                  "minLength": 1,
                  "maxLength": 256
                },
                "index": {
                  "type": "integer",
                  "description": "Where among its siblings, 0 first (the end, drawn on top, when absent).",
                  "minimum": 0,
                  "maximum": 2000
                }
              },
              "required": [
                "scene"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "profile",
          "items"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Add items",
        "readOnlyHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "update_item",
      "title": "Change an item",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "description": "The profile's id or exact name.",
            "minLength": 1,
            "maxLength": 256
          },
          "item": {
            "type": "string",
            "description": "The item's id or exact name.",
            "minLength": 1,
            "maxLength": 256
          },
          "scene": {
            "type": "object",
            "description": "A new scene for it (format infopanel.scene/1)."
          },
          "x": {
            "type": "number",
            "description": "Its new left edge, in pixels.",
            "minimum": -100000,
            "maximum": 100000
          },
          "y": {
            "type": "number",
            "description": "Its new top edge, in pixels.",
            "minimum": -100000,
            "maximum": 100000
          },
          "rotation": {
            "type": "number",
            "description": "Its rotation in degrees, clockwise.",
            "minimum": -360,
            "maximum": 360
          },
          "width": {
            "type": "number",
            "description": "Its layout box width.",
            "minimum": 0,
            "maximum": 100000
          },
          "height": {
            "type": "number",
            "description": "Its layout box height.",
            "minimum": 0,
            "maximum": 100000
          },
          "bindings": {
            "type": "object",
            "description": "Its sensor bindings, replaced whole: input name to a sensor key, or to {\"key\", \"stat\"}."
          },
          "name": {
            "type": "string",
            "description": "Its new name.",
            "minLength": 1,
            "maxLength": 256
          },
          "visible": {
            "type": "boolean",
            "description": "Shown (true) or hidden (false)."
          }
        },
        "required": [
          "profile",
          "item"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Change an item",
        "readOnlyHint": false,
        "openWorldHint": false
      }
    },
