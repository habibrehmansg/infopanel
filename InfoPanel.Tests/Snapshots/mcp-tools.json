    {
      "name": "create_profile",
      "title": "Create a profile",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The profile's name.",
            "minLength": 1,
            "maxLength": 256
          },
          "width": {
            "type": "integer",
            "description": "The canvas width in pixels.",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "description": "The canvas height in pixels.",
            "minimum": 1,
            "maximum": 16384
          },
          "background": {
            "type": "string",
            "description": "The canvas colour, #rrggbb or #rrggbbaa (black when absent).",
            "minLength": 1,
            "maxLength": 9
          }
        },
        "required": [
          "name",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
