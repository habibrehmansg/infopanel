<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>InfoPanel.Tests</RootNamespace>
    <!-- Run through VSTest (xunit.runner.visualstudio), like InfoPanel.Core.Tests. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!-- MediaFoundationAbiTests build synthetic COM objects (vtables of UnmanagedCallersOnly functions) and call the
         generated stubs' pointer parameters. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\InfoPanel.Core.Tests\Fifo.cs" Link="Linked\Fifo.cs" />
    <Compile Include="..\InfoPanel.Core.Tests\Images\LocalHttpServer.cs" Link="Linked\LocalHttpServer.cs" />
    <!-- The fake USB backend and its clock, for the panel tests over the engine. -->
    <Compile Include="..\InfoPanel.Core.Tests\Panels\Usb\FakeUsbBackend.cs" Link="Linked\FakeUsbBackend.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InfoPanel\InfoPanel.csproj" />
    <!-- The plugin host (net8.0), a library the engine runs in its host mode; its internals are visible to these tests. -->
    <ProjectReference Include="..\InfoPanel.Plugins.Host\InfoPanel.Plugins.Host.csproj" />
  </ItemGroup>

  <!-- The plugin the tests run in hosts, built and copied into plugin-fixtures/InfoPanel.TestFixture/. Not into plugins/, so
       an engine started from this folder finds no bundled plugins unless a test points the bundled-plugins flag here. -->
  <Target Name="CopyPluginFixtures" AfterTargets="CopyFilesToOutputDirectory">
    <MSBuild Projects="..\InfoPanel.Plugins.TestFixture\InfoPanel.Plugins.TestFixture.csproj" Targets="Build" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="_FixturePluginPath" />
    </MSBuild>
    <PropertyGroup>
      <_FixturePluginDir>$([System.IO.Path]::GetDirectoryName($(_FixturePluginPath)))</_FixturePluginDir>
    </PropertyGroup>
    <ItemGroup>
      <_FixturePluginFile Include="$(_FixturePluginDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FixturePluginFile)" DestinationFiles="@(_FixturePluginFile->'$(OutDir)plugin-fixtures\InfoPanel.TestFixture\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
