<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>InfoPanel.Tests</RootNamespace>
    <!-- Run through VSTest (xunit.runner.visualstudio), like InfoPanel.Core.Tests. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Extras plugins are net8.0-windows, which a net10.0 test project can't reference, so the Weather plugin's
         source is compiled into the tests; OpenWeatherMap.Cache is the package it already uses (central version). -->
    <Compile Include="..\InfoPanel.Extras\WeatherPlugin.cs" Link="Plugins\Linked\WeatherPlugin.cs" />
    <Compile Include="..\InfoPanel.Core.Tests\Fifo.cs" Link="Linked\Fifo.cs" />
    <Compile Include="..\InfoPanel.Core.Tests\Images\LocalHttpServer.cs" Link="Linked\LocalHttpServer.cs" />
    <PackageReference Include="OpenWeatherMap.Cache" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InfoPanel\InfoPanel.csproj" />
    <!-- The plugin host (net8.0), a library the engine runs in its host mode; its internals are visible to these tests. -->
    <ProjectReference Include="..\InfoPanel.Plugins.Host\InfoPanel.Plugins.Host.csproj" />
  </ItemGroup>

  <!-- Plugins the tests run in hosts, each built and copied into plugin-fixtures/{folder}/: the test plugin and the
       bundled Extras. Not into plugins/, so an engine started from this folder finds no bundled plugins unless a test
       points the bundled-plugins flag here. -->
  <Target Name="CopyPluginFixtures" AfterTargets="CopyFilesToOutputDirectory">
    <MSBuild Projects="..\InfoPanel.Plugins.TestFixture\InfoPanel.Plugins.TestFixture.csproj" Targets="Build" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="_FixturePluginPath" />
    </MSBuild>
    <MSBuild Projects="..\InfoPanel.Extras\InfoPanel.Extras.csproj" Targets="Build" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="_ExtrasPluginPath" />
    </MSBuild>
    <PropertyGroup>
      <_FixturePluginDir>$([System.IO.Path]::GetDirectoryName($(_FixturePluginPath)))</_FixturePluginDir>
      <_ExtrasPluginDir>$([System.IO.Path]::GetDirectoryName($(_ExtrasPluginPath)))</_ExtrasPluginDir>
    </PropertyGroup>
    <ItemGroup>
      <_FixturePluginFile Include="$(_FixturePluginDir)\**\*" />
      <_ExtrasPluginFile Include="$(_ExtrasPluginDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FixturePluginFile)" DestinationFiles="@(_FixturePluginFile->'$(OutDir)plugin-fixtures\InfoPanel.TestFixture\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ExtrasPluginFile)" DestinationFiles="@(_ExtrasPluginFile->'$(OutDir)plugin-fixtures\InfoPanel.Extras\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
