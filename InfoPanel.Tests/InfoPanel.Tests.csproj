<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>InfoPanel.Tests</RootNamespace>
    <!-- Run through VSTest (xunit.runner.visualstudio), like InfoPanel.Core.Tests. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Extras plugins are net8.0-windows, which a net10.0 test project can't reference, so the Weather plugin's
         source is compiled into the tests; OpenWeatherMap.Cache is the package it already uses (central version). -->
    <Compile Include="..\InfoPanel.Extras\WeatherPlugin.cs" Link="Plugins\Linked\WeatherPlugin.cs" />
    <PackageReference Include="OpenWeatherMap.Cache" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InfoPanel\InfoPanel.csproj" />
    <!-- The plugin host (net8.0) whose behaviour 2.0 keeps. Its internals are visible to these tests, its top-level
         Program among them, so it is referenced under an alias: Program here is the engine's. -->
    <ProjectReference Include="..\InfoPanel.Plugins.Host\InfoPanel.Plugins.Host.csproj" Aliases="PluginHost" />
  </ItemGroup>

</Project>
