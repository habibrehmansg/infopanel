<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>InfoPanel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfoPanel.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="SkiaSharp" />
    <!-- RenderLoop hashes rendered frames with XxHash3. -->
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="Topten.RichTextKit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Inter (OFL, see Fonts/OFL.txt), registered by FontRegistry. Resource names: InfoPanel.Fonts.<file>. -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="InfoPanel.Fonts.%(Filename)%(Extension)" />
    <!-- The format schemas (spec/schemas), validated against by SpecSchemas. Resource names: InfoPanel.Spec.Schemas.<file>. -->
    <EmbeddedResource Include="..\spec\schemas\*.schema.json" LogicalName="InfoPanel.Spec.Schemas.%(Filename)%(Extension)" />
    <!-- Example documents created on first run (Workspace). Resource names: InfoPanel.Documents.Examples.<file>. -->
    <EmbeddedResource Include="Documents\Examples\*.document.json" LogicalName="InfoPanel.Documents.Examples.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Plugins\InfoPanel.Plugins.csproj" />
  </ItemGroup>

</Project>
