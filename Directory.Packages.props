<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Plugin SDK projects -->
  <ItemGroup>
    <PackageVersion Include="AsyncKeyedLock" Version="8.0.2" />
    <PackageVersion Include="ini-parser-netstandard" Version="2.5.3" />
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />
    <PackageVersion Include="StreamJsonRpc" Version="2.24.84" />
    <PackageVersion Include="System.CommandLine" Version="2.0.6" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <!-- InfoPanel.Core (also uses Serilog and SkiaSharp above; keep SkiaSharp aligned with InfoPanel.Plugins.Graphics;
       PerformanceCounter for the system information source's Windows reader) -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.6" />
    <!-- Linux's Skia native, at SkiaSharp's own version: SkiaSharp loads only a native of its major.minor (155), and
         Topten.RichTextKit alone would pull an older one, which can't load. Move it with SkiaSharp. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.155.0" />
    <!-- HarfBuzz's Skia glue at SkiaSharp's own version, and Linux's HarfBuzz native at the HarfBuzzSharp it brings
         (Topten.RichTextKit alone would pull older ones). Move them with SkiaSharp. -->
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.155.0" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0" />
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.6" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
    <!-- The Now Playing source's Linux reader (LinuxNowPlayingReader) talks to the session bus (MPRIS) through it. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.2" />
    <PackageVersion Include="Topten.RichTextKit" Version="0.6.170" />
  </ItemGroup>

  <!-- InfoPanel (engine host). Sentry (sentry-dotnet): crash reports from release builds that name a crash-report
       address (InfoPanel/CrashReports/, docs/2.0/crash-reports.md); referenced by InfoPanel only. -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Sentry" Version="6.13.0" />
  </ItemGroup>

  <!-- InfoPanel.SensorHelper: LibreHardwareMonitorLib 0.9.6 and its dependencies, each at the latest version LHM 0.9.6
       works with (the owner's choice, 12 Nov 2026), checked offline against the types and members 0.9.6 uses and the
       packages' own dependency ranges. Not their latest releases: BlackSharp.Core 1.0.10 and later drop
       DataStorageSizeConverter, which 0.9.6 calls, so DiskInfoToolkit and RAMSPDToolkit-NDD stay at the last releases that
       take a BlackSharp.Core before it (DiskInfoToolkit 2.x is also a new API 0.9.6 doesn't call); the System packages
       stay on 10.0, as 11.0 has no net8.0 assets for the helper's net8.0-windows. Whether the sensor identifiers still match
       1.x profiles is checked next on a real PC (an identifier diff). InfoPanel.Core shares System.IO.Ports (the panel
       driver seam's serial ports) and HidSharp; the engine references no other of them. -->
  <ItemGroup>
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageVersion Include="BlackSharp.Core" Version="1.0.9" />
    <PackageVersion Include="DiskInfoToolkit" Version="1.1.2" />
    <PackageVersion Include="HidSharp" Version="2.6.4" />
    <PackageVersion Include="Mono.Posix.NETStandard" Version="1.0.0" />
    <PackageVersion Include="RAMSPDToolkit-NDD" Version="1.4.2" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.15" />
    <PackageVersion Include="System.Management" Version="10.0.15" />
    <PackageVersion Include="System.Threading.AccessControl" Version="10.0.15" />
  </ItemGroup>

  <!-- Test projects -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
