<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Plugin SDK projects and InfoPanel.Extras -->
  <ItemGroup>
    <PackageVersion Include="AsyncKeyedLock" Version="8.0.2" />
    <PackageVersion Include="ini-parser-netstandard" Version="2.5.3" />
    <PackageVersion Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageVersion Include="OpenWeatherMap.Cache" Version="3.0.0" />
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />
    <PackageVersion Include="StreamJsonRpc" Version="2.24.84" />
    <PackageVersion Include="System.CommandLine" Version="2.0.6" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.6" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <!-- InfoPanel.Core (also uses Serilog and SkiaSharp above; keep SkiaSharp aligned with InfoPanel.Plugins.Graphics) -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.6" />
    <PackageVersion Include="Svg.Skia" Version="4.3.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
    <PackageVersion Include="Topten.RichTextKit" Version="0.4.167" />
  </ItemGroup>

  <!-- InfoPanel (engine host) -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- InfoPanel.SensorHelper only: LibreHardwareMonitorLib and its dependencies, pinned to the versions 1.4.x ships (its
       net8.0 graph, which the helper's net8.0-windows restores exactly), so the sensor identifiers match 1.x profiles. Bumped
       only after an identifier diff on a real PC. The engine and InfoPanel.Core reference none of them. -->
  <ItemGroup>
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageVersion Include="BlackSharp.Core" Version="1.0.7" />
    <PackageVersion Include="DiskInfoToolkit" Version="1.1.2" />
    <PackageVersion Include="HidSharp" Version="2.6.4" />
    <PackageVersion Include="Mono.Posix.NETStandard" Version="1.0.0" />
    <PackageVersion Include="RAMSPDToolkit-NDD" Version="1.4.2" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.6" />
    <PackageVersion Include="System.Management" Version="10.0.6" />
    <PackageVersion Include="System.Threading.AccessControl" Version="10.0.6" />
  </ItemGroup>

  <!-- Test projects -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
