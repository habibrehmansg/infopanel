<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plugin for the engine's tests, never shipped: built as InfoPanel.TestFixture.dll, the name a plugin folder
       InfoPanel.TestFixture holds. Its behaviour is chosen per test by a fixture-mode.txt next to the DLL. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>InfoPanel.TestFixture</AssemblyName>
    <RootNamespace>InfoPanel.TestFixture</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Plugins\InfoPanel.Plugins.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="PluginInfo.ini">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
