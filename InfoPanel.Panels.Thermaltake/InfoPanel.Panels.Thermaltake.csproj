<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Thermaltake / ASRock panel package (family thermaltake): the Thermaltake 6" LCD (264a:2347) and the ASRock
       Phantom Gaming 360 LCD (26ce:0a10), both on one HID protocol. Its driver reaches its devices through the panel
       SDK's device seam only; panel.json is its one model table. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InfoPanel.Panels.Thermaltake</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine's panel SDK, not copied: the host gives the package its own. -->
    <ProjectReference Include="..\InfoPanel.Panels.Sdk\InfoPanel.Panels.Sdk.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfoPanel.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="panel.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="70-infopanel-thermaltake.rules" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
