<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>InfoPanel.Core.Tests</RootNamespace>
    <!-- Run through VSTest (xunit.runner.visualstudio), so dotnet test filters by trait (Category=...) work
         without opting the repo into the Microsoft.Testing.Platform `dotnet test` mode. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frozen 1.x XML fixtures, copied to the output under Fixtures/ for the persistence tests. -->
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Core\InfoPanel.Core.csproj" />
    <ProjectReference Include="..\InfoPanel.Panels.Testing\InfoPanel.Panels.Testing.csproj" />
    <!-- The virtual panel package, compiled against but not copied: its tests load it from its own output, where its
         panel.json is (PanelPackageOutput, in Panels/Testing/PanelPackagesUnderTest.cs; the path MSBuild resolved for it
         is written into this assembly by PanelPackages.targets). A copy would put its panel.json beside this assembly,
         where no driver's manifest may be. -->
    <ProjectReference Include="..\InfoPanel.Panels.Virtual\InfoPanel.Panels.Virtual.csproj" Private="false" PanelPackage="true" />
    <ProjectReference Include="..\InfoPanel.Panels.Thermaltake\InfoPanel.Panels.Thermaltake.csproj" Private="false" PanelPackage="true" />
    <ProjectReference Include="..\InfoPanel.Panels.Thermalright\InfoPanel.Panels.Thermalright.csproj" Private="false" PanelPackage="true" />
    <ProjectReference Include="..\InfoPanel.Panels.Jl\InfoPanel.Panels.Jl.csproj" Private="false" PanelPackage="true" />
    <!-- The sensor helper's stand-in, run as a child process by HelperChildProcessTests. It compiles Core's helper sources
         itself, so it is referenced under an alias no file uses: only its build output is wanted. -->
    <ProjectReference Include="..\InfoPanel.SensorHelper.TestHost\InfoPanel.SensorHelper.TestHost.csproj" Aliases="testhost" />
  </ItemGroup>

  <Import Project="..\InfoPanel.Panels.Testing\PanelPackages.targets" />

</Project>
