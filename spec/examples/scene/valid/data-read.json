      ]
    },
    "high": {"op": "cell", "input": "fc", "row": 2, "column": "high", "field": "number"},
    "tint": {"op": "parse", "as": "color", "value": {"op": "input", "name": "accent", "field": "text"}, "else": "#1f2937"},
    "pct": {
      "op": "clamp",
      "args": [{"op": "parse", "as": "number", "value": {"op": "input", "name": "level", "field": "text"}, "else": 0}, 0, 100]
    }
  },
  "nodes": [
    {
      "kind": "media",
      "x": 0,
      "y": 0,
      "w": 24,
      "h": 24,
