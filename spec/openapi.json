{
  "openapi": "3.1.1",
  "info": {
    "title": "InfoPanel engine API",
    "version": "2",
    "summary": "The engine's requests on the loopback interface: its REST API under /api, the preview socket, the health check and the sign-in link.",
    "description": "An index of the engine API: every request, its parameters, and each status it answers with its media type and body. Bodies are definitions of the schemas in schemas/ (urn:infopanel:api:1), referred to by id; docs/api.md and docs/commit.md specify the behaviour. info.version is the API's protocol, as GET /api/session reports it (docs/versioning.md#the-engine-api)."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "A running engine: on the port it was started with, else a free one, which it writes to runtime.json in its data folder.",
      "variables": {
        "port": {"default": "5199", "description": "The engine's port."}
      }
    }
  ],
  "paths": {
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "summary": "The engine, this run of it and what it supports.",
        "description": "docs/api.md#session.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The session.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/session"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      }
    },
    "/api/fonts": {
      "get": {
        "operationId": "listFonts",
        "summary": "The font families a scene's text can name.",
        "description": "docs/api.md#fonts-and-sensors.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The engine's own families first, then the system's, each sorted, each once whatever its case.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      }
    },
    "/api/sensors": {
      "get": {
        "operationId": "listSensors",
        "summary": "Every sensor the engine's sources offer, with its status now.",
        "description": "docs/api.md#fonts-and-sensors.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The sensors.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "urn:infopanel:api:1#/$defs/sensorEntry"}}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      }
    },
    "/api/sensors/values": {
      "get": {
        "operationId": "readSensorValues",
        "summary": "The reading of every listed sensor that has one now.",
        "description": "docs/api.md#fonts-and-sensors.",
        "parameters": [
          {
            "name": "history",
            "in": "query",
            "required": false,
            "description": "How many of each number sensor's last samples to add, clamped to 0–4,096; 0 when absent.",
            "schema": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
          }
        ],
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The readings, in list order.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "urn:infopanel:api:1#/$defs/sensorValue"}}}}
          },
          "400": {"$ref": "#/components/responses/badQuery"},
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "getSettings",
        "summary": "The engine settings in effect, with their version and whether the engine could read them.",
        "description": "docs/api.md#settings.",
        "security": [{"bearer": ["session"]}],
        "responses": {
          "200": {
            "description": "The settings.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/engineSettings"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"}
        }
      },
      "patch": {
        "operationId": "changeSettings",
        "summary": "Changes the settings the body names, stores them and answers the settings in effect.",
        "description": "docs/api.md#changing-settings.",
        "security": [{"bearer": ["session"]}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/settingsChange"}}}},
        "responses": {
          "200": {
            "description": "The change is stored (or changed nothing); the settings in effect.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/engineSettings"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "409": {
            "description": "The engine couldn't read its stored settings when it started, or they are another major version's: it changes none until they are fixed or removed and it restarts. Nothing was changed.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/settingsStatusProblem"}}}
          },
          "422": {
            "description": "The body breaks its definition or a limit (limit.settingsRequestBytes, limit.settingsDepth, limit.settingsClientBytes), or the settings it makes would be over a limit (limit.settingsClients, limit.settingsBytes); nothing was changed.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/invalidProblem"}}}
          }
        }
      }
    },
    "/api/logs": {
      "get": {
        "operationId": "listLogs",
        "summary": "The engine's recent log entries after a given one, oldest first.",
        "description": "docs/api.md#logs.",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "The `seq` of the last entry the client has: only newer entries are answered. Every kept entry when absent.",
            "schema": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        ],
        "security": [{"bearer": ["session"]}],
        "responses": {
          "200": {
            "description": "The entries and the newest entry's seq.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/logPage"}}}
          },
          "400": {
            "description": "`after` isn't a whole number from 0 to 9,007,199,254,740,991 in decimal digits, or is given more than once.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"}
        }
      }
    },
    "/api/folders/{folder}/open": {
      "parameters": [
        {
          "name": "folder",
          "in": "path",
          "required": true,
          "description": "Which of the engine's own folders: `data`, its data folder (the session's dataDir), or `logs`, the folder of its log files.",
          "schema": {"enum": ["data", "logs"]}
        }
      ],
      "post": {
        "operationId": "openFolder",
        "summary": "Opens one of the engine's own folders in the file manager of the computer it runs on.",
        "description": "docs/api.md#folders.",
        "security": [{"bearer": ["session"]}],
        "responses": {
          "204": {"description": "The engine asked the system's file manager to open the folder; a repeat within a second, or a request while four file managers it started haven't exited, asks nothing and is answered the same (docs/api.md#folders)."},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {
            "description": "No such folder: `folder` is neither `data` nor `logs`. The engine opens no other path.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          },
          "500": {
            "description": "The engine couldn't open the folder: it isn't there, or the file manager couldn't be started. The error is in the engine's log.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          }
        }
      }
    },
    "/api/displays": {
      "get": {
        "operationId": "listDisplays",
        "summary": "The computer's displays, the primary one first, each in the shape a profile's window.display takes.",
        "description": "docs/api.md#displays.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The displays, read when the request came; none, and `supported` false, where the engine doesn't show desktop windows.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/displayList"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "500": {
            "description": "The engine couldn't list the displays: the system didn't answer within 5 seconds, or failed. The error is in the engine's log.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          }
        }
      }
    },
    "/api/profiles": {
      "get": {
        "operationId": "listProfiles",
        "summary": "Every profile, in display order.",
        "description": "docs/api.md#profiles.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The profiles.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "urn:infopanel:api:1#/$defs/profileEntry"}}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      },
      "post": {
        "operationId": "createProfile",
        "summary": "Creates a profile under a client-chosen id, empty or from a document.",
        "description": "docs/api.md#creating-and-duplicating.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/createProfileRequest"}}}
        },
        "responses": {
          "201": {
            "description": "The new profile.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/profileEntry"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "409": {
            "description": "A profile with the id exists; nothing was created.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/existsProblem"}}}
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "get": {
        "operationId": "getProfile",
        "summary": "The profile's current document and its state.",
        "description": "docs/api.md#documents.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The document.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/documentResponse"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {"$ref": "#/components/responses/profileStatus"}
        }
      },
      "delete": {
        "operationId": "deleteProfile",
        "summary": "Deletes the profile, whatever its status, with its document and history, when the request names its tag.",
        "description": "docs/api.md#deleting.",
        "parameters": [
          {
            "name": "instance",
            "in": "query",
            "required": true,
            "description": "The document's tag, from its profile entry or document: another profile created under the id meanwhile isn't deleted.",
            "schema": {"$ref": "urn:infopanel:api:1#/$defs/instanceId"}
          }
        ],
        "security": [{"bearer": ["edit"]}],
        "responses": {
          "204": {"description": "Deleted."},
          "400": {
            "description": "No instance, or not exactly one of 1–64 characters; checked before anything else.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The instance isn't the profile's tag (deleteConflictProblem, one instance conflict): nothing was deleted.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/deleteConflictProblem"}}}
          }
        }
      }
    },
    "/api/profiles/{id}/duplicate": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "duplicateProfile",
        "summary": "Copies the profile's current document under a client-chosen id.",
        "description": "docs/api.md#creating-and-duplicating.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/duplicateProfileRequest"}}}
        },
        "responses": {
          "201": {
            "description": "The new profile.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/profileEntry"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "A profile with the new id exists (existsProblem), or this one can't be opened (profileStatusProblem); nothing was created.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/existsProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/document": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "get": {
        "operationId": "exportProfile",
        "summary": "The profile's document, to keep or to create a profile from elsewhere.",
        "description": "docs/api.md#exporting.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The profile's current document without its rev members, scenes and opaque members as stored.",
            "content": {
              "application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/importDocument"}}
            }
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem): it isn't exported.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"}}}
          }
        }
      }
    },
    "/api/profiles/{id}/archive": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "get": {
        "operationId": "exportArchive",
        "summary": "The profile as a profile archive (.infopanel2): its manifest, its document and every blob it refers to.",
        "description": "docs/archive.md#exporting.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {"description": "The archive, with Content-Disposition naming it.", "content": {"application/zip": {}}},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), or its archive would be one its import refuses (exportProblem): no archive is made.",
            "content": {"application/problem+json": {"schema": {"oneOf": [
              {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
              {"$ref": "urn:infopanel:api:1#/$defs/exportProblem"}
            ]}}}
          }
        }
      }
    },
    "/api/profiles/{id}/thumbnail": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "get": {
        "operationId": "getThumbnail",
        "summary": "A PNG of the current document.",
        "description": "docs/api.md#thumbnails.",
        "parameters": [
          {
            "name": "w",
            "in": "query",
            "required": false,
            "description": "The width in pixels, clamped to 16–4,096; 320 when absent.",
            "schema": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
          }
        ],
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {"description": "The thumbnail.", "content": {"image/png": {}}},
          "400": {"$ref": "#/components/responses/badQuery"},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {"$ref": "#/components/responses/profileStatus"}
        }
      }
    },
    "/api/profiles/{id}/commit": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "commit",
        "summary": "Applies ops to the document, all or none, as one undo step.",
        "description": "docs/commit.md.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitRequest"}}}},
        "responses": {
          "200": {
            "description": "The commit's result.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), an op conflicts (conflictProblem), or the commit is too old to tell from a retry (expiredProblem); nothing was applied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/expiredProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/undo": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "undo",
        "summary": "Undoes the last undo step.",
        "description": "docs/commit.md#undo-redo-revert-and-save.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/historyRequest"}}}
        },
        "responses": {
          "200": {
            "description": "The document's state after the step.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), or the request names another document's tag or the document changed since baseRev (conflictProblem); nothing was applied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/redo": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "redo",
        "summary": "Redoes the last undone step.",
        "description": "docs/commit.md#undo-redo-revert-and-save.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/historyRequest"}}}
        },
        "responses": {
          "200": {
            "description": "The document's state after the step.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), or the request names another document's tag or the document changed since baseRev (conflictProblem); nothing was applied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/revert": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "revert",
        "summary": "Returns the document to its saved state, as one undo step.",
        "description": "docs/commit.md#undo-redo-revert-and-save.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/historyRequest"}}}
        },
        "responses": {
          "200": {
            "description": "The document's state after the step.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), or the request names another document's tag or the document changed since baseRev (conflictProblem); nothing was applied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/save": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "save",
        "summary": "Saves the document as it is when the save starts.",
        "description": "docs/commit.md#undo-redo-revert-and-save.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "description": "Optional: the document's tag and the revision to save. Without a body the save isn't guarded.",
          "required": false,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/historyRequest"}}}
        },
        "responses": {
          "200": {
            "description": "The document's state once the write is done.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), or the body names another document's tag or the document changed since baseRev (conflictProblem); nothing was saved.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/blobs": {
      "post": {
        "operationId": "storeBlob",
        "summary": "Stores bytes as a blob, named by their SHA-256, and inspects them as media.",
        "description": "docs/api.md#blobs.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {"required": true, "description": "The bytes, of any content type.", "content": {"application/octet-stream": {}}},
        "responses": {
          "200": {
            "description": "The bytes were already stored.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/blobInfo"}}}
          },
          "201": {
            "description": "The bytes are stored.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/blobInfo"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "413": {
            "description": "The bytes are over mediaBytes; nothing was stored.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          }
        }
      }
    },
    "/api/blobs/{id}": {
      "parameters": [{"$ref": "#/components/parameters/blobId"}],
      "head": {
        "operationId": "headBlob",
        "summary": "The blob's size.",
        "description": "docs/api.md#blobs.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The blob is stored; Content-Length is its size.",
            "headers": {
              "Content-Length": {"description": "The blob's size in bytes.", "required": true, "schema": {"type": "integer", "minimum": 0}}
            },
            "content": {"application/octet-stream": {}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"}
        }
      },
      "get": {
        "operationId": "getBlob",
        "summary": "The blob's bytes, exactly as stored.",
        "description": "docs/api.md#blobs.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {"description": "The bytes.", "content": {"application/octet-stream": {}}},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"}
        }
      }
    },
    "/api/import/archive": {
      "post": {
        "operationId": "openArchive",
        "summary": "Opens a profile archive (.infopanel2): checks it, stores its blobs and answers its document; creates nothing.",
        "description": "docs/archive.md#importing.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {"required": true, "description": "The archive's bytes, of any content type.", "content": {"application/octet-stream": {}}},
        "responses": {
          "200": {
            "description": "The archive's document, the blobs it carried (stored) and the ones it lacks.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/archiveContents"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "413": {
            "description": "The bytes are over archiveBytes; nothing was read or stored.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          },
          "422": {
            "description": "The archive breaks a guard or its format (archive.*), needs a newer engine (unsupported.*, under /manifest or /document), breaks a limit (limit.*) or holds a document a create would refuse (under /document): nothing is created, and only blobs verified before the refusal may be stored.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/invalidProblem"}}}
          }
        }
      }
    },
    "/api/import/v1": {
      "get": {
        "operationId": "getV1Migration",
        "summary": "The 1.x migration: its state, the 1.x folder and, when it has 1.x data, its profiles, settings and diagnostics.",
        "description": "docs/import.md#migrating-a-1x-folder.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The migration's state.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/v1Migration"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      },
      "put": {
        "operationId": "recordV1Migration",
        "summary": "Stores what a migration did as the run-once record, replacing any record, and answers the new state.",
        "description": "docs/import.md#the-record.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/v1MigrationRequest"}}}},
        "responses": {
          "200": {
            "description": "The record is stored; the migration's state, now done.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/v1Migration"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "422": {
            "description": "The body breaks its definition or a limit (limit.recordBytes, limit.recordOutcomes); nothing was stored.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/invalidProblem"}}}
          }
        }
      }
    },
    "/api/import/v1/profiles/{v1Id}": {
      "parameters": [{"$ref": "#/components/parameters/v1Id"}],
      "post": {
        "operationId": "readV1FolderProfile",
        "summary": "Reads one profile of the 1.x folder into its envelope, storing its image files as blobs; installs nothing.",
        "description": "docs/import.md#the-envelope.",
        "security": [{"bearer": ["edit"]}],
        "responses": {
          "200": {
            "description": "The profile's envelope.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/v1Profile"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "422": {
            "description": "The folder holds 1.1.x data, which isn't imported (import.version); nothing was stored.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/invalidProblem"}}}
          }
        }
      }
    },
    "/api/import/v1/archive": {
      "post": {
        "operationId": "readV1Archive",
        "summary": "Reads a 1.x .infopanel file into its envelope, storing its image files as blobs; installs nothing.",
        "description": "docs/import.md#the-envelope.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {"required": true, "description": "The file's bytes, of any content type.", "content": {"application/octet-stream": {}}},
        "responses": {
          "200": {
            "description": "The profile's envelope.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/v1Profile"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "413": {
            "description": "The bytes are over archiveBytes; nothing was read or stored.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          },
          "422": {
            "description": "The file breaks an archive guard (archive.*), isn't a 1.x profile export (import.archive, archive.v2) or its Profile.xml can't be read (import.xml); nothing was stored.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/invalidProblem"}}}
          }
        }
      }
    },
    "/api/tokens": {
      "get": {
        "operationId": "listTokens",
        "summary": "The integration tokens, oldest first, without their secrets.",
        "description": "docs/api.md#integration-tokens.",
        "security": [{"bearer": ["session"]}],
        "responses": {
          "200": {
            "description": "The tokens.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "urn:infopanel:api:1#/$defs/tokenInfo"}}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"}
        }
      },
      "post": {
        "operationId": "createToken",
        "summary": "Creates an integration token and answers its secret, once.",
        "description": "docs/api.md#integration-tokens.",
        "security": [{"bearer": ["session"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/createTokenRequest"}}}
        },
        "responses": {
          "201": {
            "description": "The new token and its secret.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/createdToken"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "422": {
            "description": "The body breaks its definition or a limit, or the stored tokens would be over tokensBytes (limit.tokensBytes); nothing was created.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/invalidProblem"}}}
          }
        }
      }
    },
    "/api/tokens/{id}": {
      "parameters": [
        {"name": "id", "in": "path", "required": true, "description": "The token's id (tokenId).", "schema": {"type": "string"}}
      ],
      "delete": {
        "operationId": "revokeToken",
        "summary": "Revokes an integration token at once.",
        "description": "docs/api.md#integration-tokens.",
        "security": [{"bearer": ["session"]}],
        "responses": {
          "204": {"description": "Revoked; the sockets opened with it are closed."},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"}
        }
      }
    },
    "/ws": {
      "get": {
        "operationId": "previewSocket",
        "summary": "The preview socket: a WebSocket with the subprotocol infopanel.v1.",
        "description": "docs/api.md#the-preview-socket. The upgrade takes no Authorization header: the token comes as the subprotocol auth.{token} or in the first message (authMessage).",
        "security": [{"socketToken": ["read"]}],
        "responses": {
          "101": {
            "description": "Switching to the WebSocket: the engine sends serverMessage text messages and binary frames, the client clientMessage text messages."
          },
          "400": {
            "description": "Not a WebSocket upgrade.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          },
          "401": {
            "description": "No infopanel.v1 subprotocol, or an auth.{token} subprotocol whose token isn't valid.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          }
        },
        "x-infopanel-socket": {
          "subprotocol": "infopanel.v1",
          "clientMessage": {"$ref": "urn:infopanel:api:1#/$defs/clientMessage"},
          "serverMessage": {"$ref": "urn:infopanel:api:1#/$defs/serverMessage"},
          "frameHeader": {"$ref": "urn:infopanel:api:1#/$defs/frameHeader"}
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Whether the engine runs.",
        "description": "docs/api.md#signing-in.",
        "security": [],
        "responses": {"200": {"description": "The text ok.", "content": {"text/plain": {}}}}
      }
    },
    "/auth/{token}": {
      "parameters": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "description": "The token from the sign-in link the engine prints.",
          "schema": {"type": "string"}
        }
      ],
      "get": {
        "operationId": "signIn",
        "summary": "The sign-in link: hands the session token to the client served by the engine.",
        "description": "docs/api.md#signing-in.",
        "security": [],
        "responses": {
          "302": {
            "description": "To /#token={token}.",
            "headers": {"Location": {"description": "/#token={token}", "required": true, "schema": {"type": "string"}}}
          },
          "401": {"description": "Any token but the session token.", "content": {"text/plain": {}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "v1Id": {
        "name": "v1Id",
        "in": "path",
        "required": true,
        "description": "The 1.x profile's Guid, as the migration's state lists it.",
        "schema": {"type": "string"}
      },
      "profileId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The profile's id: its document's id.",
        "schema": {"type": "string"}
      },
      "blobId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The blob's id: sha256: and 64 lower-case hex digits.",
        "schema": {"type": "string"}
      }
    },
    "responses": {
      "badQuery": {
        "description": "A query parameter isn't a whole number from −2,147,483,648 to 2,147,483,647.",
        "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
      },
      "unauthorized": {
        "description": "No token, or one the engine doesn't know or has revoked.",
        "headers": {"WWW-Authenticate": {"description": "Bearer", "required": true, "schema": {"type": "string"}}},
        "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
      },
      "forbidden": {
        "description": "The token lacks the scope the request needs.",
        "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/scopeProblem"}}}
      },
      "notFound": {
        "description": "No such profile, blob or token.",
        "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
      },
      "profileStatus": {
        "description": "The profile's document can't be opened: its status is unsupported or unreadable.",
        "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"}}}
      },
      "invalid": {
        "description": "The body breaks its definition, the formats, a rule or a limit; nothing was applied.",
        "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/invalidProblem"}}}
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The session token or an integration token: Authorization: Bearer {token}. A security requirement lists the scope the request needs: read, edit (which implies read) or session (the session token only)."
      },
      "socketToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Sec-WebSocket-Protocol",
        "description": "The token as the subprotocol auth.{token}, offered with infopanel.v1; or, when no auth.* subprotocol is offered, as the first message (authMessage) within 5 seconds."
      }
    }
  }
}
