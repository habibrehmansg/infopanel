{
  "openapi": "3.1.1",
  "info": {
    "title": "InfoPanel engine API",
    "version": "2",
    "summary": "The engine's requests on the loopback interface: its REST API under /api, the preview socket, the health check and the sign-in link.",
    "description": "An index of the engine API: every request, its parameters, and each status it answers with its media type and body. Bodies are definitions of the schemas in schemas/ (urn:infopanel:api:1), referred to by id; docs/api.md and docs/commit.md specify the behaviour. info.version is the API's protocol, as GET /api/session reports it (docs/versioning.md#the-engine-api)."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "A running engine: on the port it was started with, else a free one, which it writes to runtime.json in its data folder.",
      "variables": {
        "port": {"default": "5199", "description": "The engine's port."}
      }
    }
  ],
  "paths": {
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "summary": "The engine, this run of it and what it supports.",
        "description": "docs/api.md#session.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The session.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/session"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      }
    },
    "/api/fonts": {
      "get": {
        "operationId": "listFonts",
        "summary": "The font families a scene's text can name.",
        "description": "docs/api.md#fonts-and-sensors.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The engine's own families first, then the system's, each sorted, each once whatever its case.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      }
    },
    "/api/sensors": {
      "get": {
        "operationId": "listSensors",
        "summary": "Every sensor the engine's sources offer, with its status now.",
        "description": "docs/api.md#fonts-and-sensors.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The sensors.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "urn:infopanel:api:1#/$defs/sensorEntry"}}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      }
    },
    "/api/sensors/values": {
      "get": {
        "operationId": "readSensorValues",
        "summary": "The reading of every listed sensor that has one now.",
        "description": "docs/api.md#fonts-and-sensors.",
        "parameters": [
          {
            "name": "history",
            "in": "query",
            "required": false,
            "description": "How many of each number sensor's last samples to add, clamped to 0–4,096; 0 when absent.",
            "schema": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
          }
        ],
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The readings, in list order.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "urn:infopanel:api:1#/$defs/sensorValue"}}}}
          },
          "400": {"$ref": "#/components/responses/badQuery"},
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      }
    },
    "/api/profiles": {
      "get": {
        "operationId": "listProfiles",
        "summary": "Every profile, in display order.",
        "description": "docs/api.md#profiles.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The profiles.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "urn:infopanel:api:1#/$defs/profileEntry"}}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"}
        }
      },
      "post": {
        "operationId": "createProfile",
        "summary": "Creates a profile under a client-chosen id, empty or from a document.",
        "description": "docs/api.md#creating-and-duplicating.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/createProfileRequest"}}}
        },
        "responses": {
          "201": {
            "description": "The new profile.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/profileEntry"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "409": {
            "description": "A profile with the id exists; nothing was created.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/existsProblem"}}}
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "get": {
        "operationId": "getProfile",
        "summary": "The profile's current document and its state.",
        "description": "docs/api.md#documents.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The document.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/documentResponse"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {"$ref": "#/components/responses/profileStatus"}
        }
      },
      "delete": {
        "operationId": "deleteProfile",
        "summary": "Deletes the profile, whatever its status, with its document and history.",
        "description": "docs/api.md#deleting.",
        "security": [{"bearer": ["edit"]}],
        "responses": {
          "204": {"description": "Deleted."},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"}
        }
      }
    },
    "/api/profiles/{id}/duplicate": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "duplicateProfile",
        "summary": "Copies the profile's current document under a client-chosen id.",
        "description": "docs/api.md#creating-and-duplicating.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/duplicateProfileRequest"}}}
        },
        "responses": {
          "201": {
            "description": "The new profile.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/profileEntry"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "A profile with the new id exists (existsProblem), or this one can't be opened (profileStatusProblem); nothing was created.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/existsProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/document": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "get": {
        "operationId": "exportProfile",
        "summary": "The profile's document, to keep or to create a profile from elsewhere.",
        "description": "docs/api.md#exporting.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "An ok profile's current document without its rev members, scenes and opaque members as stored (application/json); an unsupported or unreadable profile's stored file, byte for byte (application/octet-stream).",
            "content": {
              "application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/importDocument"}},
              "application/octet-stream": {}
            }
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile's file can't be read at all.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"}}}
          }
        }
      }
    },
    "/api/profiles/{id}/thumbnail": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "get": {
        "operationId": "getThumbnail",
        "summary": "A PNG of the current document.",
        "description": "docs/api.md#thumbnails.",
        "parameters": [
          {
            "name": "w",
            "in": "query",
            "required": false,
            "description": "The width in pixels, clamped to 16–4,096; 320 when absent.",
            "schema": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
          }
        ],
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {"description": "The thumbnail.", "content": {"image/png": {}}},
          "400": {"$ref": "#/components/responses/badQuery"},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {"$ref": "#/components/responses/profileStatus"}
        }
      }
    },
    "/api/profiles/{id}/commit": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "commit",
        "summary": "Applies ops to the document, all or none, as one undo step.",
        "description": "docs/commit.md.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitRequest"}}}},
        "responses": {
          "200": {
            "description": "The commit's result.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), an op conflicts (conflictProblem), or the commit is too old to tell from a retry (expiredProblem); nothing was applied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/expiredProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/undo": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "undo",
        "summary": "Undoes the last undo step.",
        "description": "docs/commit.md#undo-redo-revert-and-save.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/historyRequest"}}}
        },
        "responses": {
          "200": {
            "description": "The document's state after the step.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), or the request names another instance or the document changed since baseRev (conflictProblem); nothing was applied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/redo": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "redo",
        "summary": "Redoes the last undone step.",
        "description": "docs/commit.md#undo-redo-revert-and-save.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/historyRequest"}}}
        },
        "responses": {
          "200": {
            "description": "The document's state after the step.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), or the request names another instance or the document changed since baseRev (conflictProblem); nothing was applied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/revert": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "revert",
        "summary": "Returns the document to its saved state, as one undo step.",
        "description": "docs/commit.md#undo-redo-revert-and-save.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/historyRequest"}}}
        },
        "responses": {
          "200": {
            "description": "The document's state after the step.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {
            "description": "The profile can't be opened (profileStatusProblem), or the request names another instance or the document changed since baseRev (conflictProblem); nothing was applied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "urn:infopanel:api:1#/$defs/profileStatusProblem"},
                    {"$ref": "urn:infopanel:api:1#/$defs/conflictProblem"}
                  ]
                }
              }
            }
          },
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/profiles/{id}/save": {
      "parameters": [{"$ref": "#/components/parameters/profileId"}],
      "post": {
        "operationId": "save",
        "summary": "Saves the current document.",
        "description": "docs/commit.md#undo-redo-revert-and-save.",
        "security": [{"bearer": ["edit"]}],
        "responses": {
          "200": {
            "description": "The document's state after saving.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/commitResult"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"},
          "409": {"$ref": "#/components/responses/profileStatus"}
        }
      }
    },
    "/api/blobs": {
      "post": {
        "operationId": "storeBlob",
        "summary": "Stores bytes as a blob, named by their SHA-256, and inspects them as media.",
        "description": "docs/api.md#blobs.",
        "security": [{"bearer": ["edit"]}],
        "requestBody": {"required": true, "description": "The bytes, of any content type.", "content": {"application/octet-stream": {}}},
        "responses": {
          "200": {
            "description": "The bytes were already stored.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/blobInfo"}}}
          },
          "201": {
            "description": "The bytes are stored.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/blobInfo"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "413": {
            "description": "The bytes are over mediaBytes; nothing was stored.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          }
        }
      }
    },
    "/api/blobs/{id}": {
      "parameters": [{"$ref": "#/components/parameters/blobId"}],
      "head": {
        "operationId": "headBlob",
        "summary": "The blob's size.",
        "description": "docs/api.md#blobs.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {
            "description": "The blob is stored; Content-Length is its size.",
            "headers": {
              "Content-Length": {"description": "The blob's size in bytes.", "required": true, "schema": {"type": "integer", "minimum": 0}}
            },
            "content": {"application/octet-stream": {}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"}
        }
      },
      "get": {
        "operationId": "getBlob",
        "summary": "The blob's bytes, exactly as stored.",
        "description": "docs/api.md#blobs.",
        "security": [{"bearer": ["read"]}],
        "responses": {
          "200": {"description": "The bytes.", "content": {"application/octet-stream": {}}},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "404": {"$ref": "#/components/responses/notFound"}
        }
      }
    },
    "/api/tokens": {
      "get": {
        "operationId": "listTokens",
        "summary": "The integration tokens, oldest first, without their secrets.",
        "description": "docs/api.md#integration-tokens.",
        "security": [{"bearer": ["session"]}],
        "responses": {
          "200": {
            "description": "The tokens.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "urn:infopanel:api:1#/$defs/tokenInfo"}}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"}
        }
      },
      "post": {
        "operationId": "createToken",
        "summary": "Creates an integration token and answers its secret, once.",
        "description": "docs/api.md#integration-tokens.",
        "security": [{"bearer": ["session"]}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/createTokenRequest"}}}
        },
        "responses": {
          "201": {
            "description": "The new token and its secret.",
            "content": {"application/json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/createdToken"}}}
          },
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "422": {"$ref": "#/components/responses/invalid"}
        }
      }
    },
    "/api/tokens/{id}": {
      "parameters": [
        {"name": "id", "in": "path", "required": true, "description": "The token's id (tokenId).", "schema": {"type": "string"}}
      ],
      "delete": {
        "operationId": "revokeToken",
        "summary": "Revokes an integration token at once.",
        "description": "docs/api.md#integration-tokens.",
        "security": [{"bearer": ["session"]}],
        "responses": {
          "204": {"description": "Revoked; the sockets opened with it are closed."},
          "401": {"$ref": "#/components/responses/unauthorized"},
          "403": {"$ref": "#/components/responses/forbidden"},
          "404": {"$ref": "#/components/responses/notFound"}
        }
      }
    },
    "/ws": {
      "get": {
        "operationId": "previewSocket",
        "summary": "The preview socket: a WebSocket with the subprotocol infopanel.v1.",
        "description": "docs/api.md#the-preview-socket. The upgrade takes no Authorization header: the token comes as the subprotocol auth.{token} or in the first message (authMessage).",
        "security": [{"socketToken": ["read"]}],
        "responses": {
          "101": {
            "description": "Switching to the WebSocket: the engine sends serverMessage text messages and binary frames, the client clientMessage text messages."
          },
          "400": {
            "description": "Not a WebSocket upgrade.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          },
          "401": {
            "description": "No infopanel.v1 subprotocol, or an auth.{token} subprotocol whose token isn't valid.",
            "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
          }
        },
        "x-infopanel-socket": {
          "subprotocol": "infopanel.v1",
          "clientMessage": {"$ref": "urn:infopanel:api:1#/$defs/clientMessage"},
          "serverMessage": {"$ref": "urn:infopanel:api:1#/$defs/serverMessage"},
          "frameHeader": {"$ref": "urn:infopanel:api:1#/$defs/frameHeader"}
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Whether the engine runs.",
        "description": "docs/api.md#signing-in.",
        "security": [],
        "responses": {"200": {"description": "The text ok.", "content": {"text/plain": {}}}}
      }
    },
    "/auth/{token}": {
      "parameters": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "description": "The token from the sign-in link the engine prints.",
          "schema": {"type": "string"}
        }
      ],
      "get": {
        "operationId": "signIn",
        "summary": "The sign-in link: hands the session token to the client served by the engine.",
        "description": "docs/api.md#signing-in.",
        "security": [],
        "responses": {
          "302": {
            "description": "To /#token={token}.",
            "headers": {"Location": {"description": "/#token={token}", "required": true, "schema": {"type": "string"}}}
          },
          "401": {"description": "Any token but the session token.", "content": {"text/plain": {}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "profileId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The profile's id: its document's id.",
        "schema": {"type": "string"}
      },
      "blobId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The blob's id: sha256: and 64 lower-case hex digits.",
        "schema": {"type": "string"}
      }
    },
    "responses": {
      "badQuery": {
        "description": "A query parameter isn't a whole number from −2,147,483,648 to 2,147,483,647.",
        "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
      },
      "unauthorized": {
        "description": "No token, or one the engine doesn't know or has revoked.",
        "headers": {"WWW-Authenticate": {"description": "Bearer", "required": true, "schema": {"type": "string"}}},
        "content": {"application/problem+json": {"schema": {"$ref": "urn:infopanel:api:1#/$defs/problem"}}}
      },
      "forbidden": {
        "description": "The token lacks the scope the request needs.",
