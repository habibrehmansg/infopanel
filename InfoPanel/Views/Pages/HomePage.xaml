<Page
    x:Class="InfoPanel.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:InfoPanel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfoPanel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DesignPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="20,0,20,20">
        <Border
            Grid.Row="0"
            Height="400"
            Margin="0,0,0,0"
            CornerRadius="8,8,8,8">
            <Border.Background>
                <ImageBrush ImageSource="/InfoPanel;component/Resources/Images/home.jpg" Stretch="UniformToFill" />
            </Border.Background>
            <Border CornerRadius="8,8,8,8">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#2F000000" />
                        <GradientStop Offset="1" Color="#8F000000" />
                    </RadialGradientBrush>
                </Border.Background>
                <StackPanel
                    Margin="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Text="{DynamicResource Home_Welcome}" />
                    <TextBlock
                        FontSize="18"
                        Foreground="#B7FFFFFF"
                        Text="{DynamicResource Home_LevelUp}" />
                </StackPanel>
            </Border>
        </Border>

        <Grid Grid.Row="1" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Start left grid  -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <ui:CardAction
                    Command="{Binding ViewModel.NavigateCommand}"
                    CommandParameter="navigate_to_profiles"
                    Icon="{ui:SymbolIcon List20}">
                    <StackPanel>
                        <TextBlock
                            Margin="0"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{DynamicResource Nav_Profiles}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Home_ProfilesDesc}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Margin="0,10,0,0"
                    Command="{Binding ViewModel.NavigateCommand}"
                    CommandParameter="navigate_to_design"
                    Icon="{ui:SymbolIcon DesktopCursor20}">
                    <StackPanel>
                        <TextBlock
                            Margin="0"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{DynamicResource Nav_Design}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Home_DesignDesc}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Margin="0,10,0,0"
                    Command="{Binding ViewModel.NavigateCommand}"
                    CommandParameter="navigate_to_updates"
                    Icon="{ui:SymbolIcon PhoneUpdate20}">
                    <StackPanel>
                        <TextBlock
                            Margin="0"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{DynamicResource Nav_Updates}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Home_UpdatesDesc}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Margin="0,10,0,0"
                    Command="{Binding ViewModel.NavigateCommand}"
                    CommandParameter="navigate_to_plugins"
                    Icon="{ui:SymbolIcon PlugConnected20}">
                    <StackPanel>
                        <TextBlock
                            Margin="0"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{DynamicResource Nav_Plugins}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Home_PluginsDesc}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Margin="0,10,0,0"
                    Command="{Binding ViewModel.NavigateCommand}"
                    CommandParameter="navigate_to_settings"
                    Icon="{ui:SymbolIcon Settings20}">
                    <StackPanel>
                        <TextBlock
                            Margin="0"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{DynamicResource Nav_Settings}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Home_SettingsDesc}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction
                    Margin="0,10,0,0"
                    Command="{Binding ViewModel.NavigateCommand}"
                    CommandParameter="navigate_to_about"
                    Icon="{ui:SymbolIcon ChatHelp20}">
                    <StackPanel>
                        <TextBlock
                            Margin="0"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{DynamicResource Nav_About}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Home_AboutDesc}" />
                    </StackPanel>
                </ui:CardAction>

            </StackPanel>

            <!--  Start right grid  -->
            <StackPanel
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center">
                <ui:CardControl Margin="0,0,0,0" Icon="{ui:SymbolIcon Heart20}">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Text="{DynamicResource Home_LoveInfoPanel}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="{DynamicResource Home_LoveInfoPanelDesc}" />
                            </StackPanel>
                            <ui:Anchor
                                Grid.Column="1"
                                Width="100"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Appearance="Secondary"
                                Content="{DynamicResource Common_Review}"
                                NavigateUri="ms-windows-store://review/?ProductId=XPFP7C8H5446ZD" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <ui:CardControl Margin="0,10,0,0" Icon="{ui:SymbolIcon DrinkCoffee20}">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Text="{DynamicResource Home_SupportDev}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="{DynamicResource Home_SupportDevDesc}" />
                            </StackPanel>
                            <ui:Anchor
                                Grid.Column="1"
                                Width="100"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Appearance="Secondary"
                                Content="{DynamicResource Common_Donate}"
                                NavigateUri="https://www.buymeacoffee.com/urfath3r" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <ui:CardControl Margin="0,10,0,0" Icon="{ui:SymbolIcon Chat20}">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Text="Discord" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="{DynamicResource Home_DiscordDesc}" />
                            </StackPanel>
                            <ui:Anchor
                                Grid.Column="1"
                                Width="100"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Appearance="Secondary"
                                Content="{DynamicResource Common_Join}"
                                NavigateUri="https://discord.gg/cQnjdMC7Qc" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <ui:CardControl Margin="0,10,0,0" Icon="{ui:SymbolIcon WebAsset20}">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Text="Reddit" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="{DynamicResource Home_RedditDesc}" />
                            </StackPanel>
                            <ui:Anchor
                                Grid.Column="1"
                                Width="100"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Appearance="Secondary"
                                Content="{DynamicResource Common_Launch}"
                                NavigateUri="https://www.reddit.com/r/InfoPanel/" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>
            </StackPanel>
        </Grid>



    </StackPanel>
</Page>
