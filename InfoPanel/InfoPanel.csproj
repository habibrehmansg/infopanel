<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InfoPanel</AssemblyName>
    <RootNamespace>InfoPanel</RootNamespace>
    <Version>2.0.0-dev</Version>
    <IsPackable>false</IsPackable>
    <!-- Desktop/MacOS calls objc_msgSend through typed function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- `dotnet run` keeps the caller's folder (the Web SDK would switch to this project folder), so relative data
         folder, web root and 1.x import paths resolve as they do in the caller's shell (a test runner that starts the
         engine from its own folder can pass a relative data folder and web root). -->
    <EnableDefaultRunWorkingDirectory>false</EnableDefaultRunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfoPanel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Core\InfoPanel.Core.csproj" />
  </ItemGroup>

</Project>
