<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InfoPanel</AssemblyName>
    <RootNamespace>InfoPanel</RootNamespace>
    <Version>2.0.0-dev</Version>
    <IsPackable>false</IsPackable>
    <!-- Desktop/MacOS calls objc_msgSend through typed function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- `dotnet run` keeps the caller's folder (the Web SDK would switch to this project folder), so relative data
         folder, web root and 1.x import paths resolve as they do in the caller's shell (a test runner that starts the
         engine from its own folder can pass a relative data folder and web root). -->
    <EnableDefaultRunWorkingDirectory>false</EnableDefaultRunWorkingDirectory>
    <!-- Windows: asInvoker, and Common Controls 6 for the notification-area icon's task dialog (copied into the
         apphost, InfoPanel.exe, when it is built on Windows). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows: the program's icon (Explorer, the taskbar, Start), written into the apphost when it is built on
         Windows; packaging/windows/make-icon.ps1 makes it from Images/logo.png. -->
    <ApplicationIcon>..\packaging\windows\InfoPanel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfoPanel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Core\InfoPanel.Core.csproj" />
    <!-- The plugin host (net8.0, as the plugin SDK): the engine executable runs it as its plugin host mode. -->
    <ProjectReference Include="..\InfoPanel.Plugins.Host\InfoPanel.Plugins.Host.csproj" />
  </ItemGroup>

  <!-- The built-in text for AI apps (tool wording, the guide, the checks' thresholds): embedded under its path, not
       copied to the output as content. -->
  <ItemGroup>
    <Content Remove="Mcp\Text\**" />
    <None Remove="Mcp\Text\**" />
    <EmbeddedResource Include="Mcp\Text\**\*.json;Mcp\Text\**\*.md" LogicalName="InfoPanel.Mcp.Text/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The app's coloured logo, the Windows notification-area icon's image (Shell/Windows/WinTrayLogo.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="..\Images\logo.png" LogicalName="InfoPanel.Shell.logo.png" Link="Shell\Windows\logo.png" />
  </ItemGroup>

  <!-- The bundled plugins: InfoPanel.Extras is built and its output copied into plugins/InfoPanel.Extras/ beside the
       engine (on build and on publish), where the engine finds it. Copied, not referenced (it is net8.0-windows), and
       not as content, so projects that reference the engine (the tests) don't get a plugins folder. It is built even
       when the engine isn't (publish's no-build). -->
  <Target Name="BuildBundledPlugins">
    <MSBuild Projects="..\InfoPanel.Extras\InfoPanel.Extras.csproj" Targets="Build" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishDir;NoBuild">
      <Output TaskParameter="TargetOutputs" PropertyName="_ExtrasPath" />
    </MSBuild>
    <PropertyGroup>
      <_ExtrasDir>$([System.IO.Path]::GetDirectoryName($(_ExtrasPath)))</_ExtrasDir>
    </PropertyGroup>
    <ItemGroup>
      <_BundledPluginFile Include="$(_ExtrasDir)\**\*" />
      <_BundledPluginFile>
        <RelativePath>plugins\InfoPanel.Extras\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      </_BundledPluginFile>
    </ItemGroup>
  </Target>

  <!-- Not being a reference (NuGet leaves a reference that doesn't take its output out of the restore graph), the
       bundled plugin is restored with the engine: after the engine's own restore, in the same restore step, so its build
       is evaluated after it, and never when the restore is left out (no-restore, no-build). The solution restores it
       on its own; a project that only references the engine doesn't. -->
  <Target Name="RestoreBundledPlugins" AfterTargets="Restore">
    <MSBuild Projects="..\InfoPanel.Extras\InfoPanel.Extras.csproj" Targets="Restore" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishDir;NoBuild" />
  </Target>

  <Target Name="CopyBundledPlugins" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="BuildBundledPlugins">
    <Copy SourceFiles="@(_BundledPluginFile)" DestinationFiles="@(_BundledPluginFile->'$(OutDir)%(RelativePath)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Added after the publish list is computed: the SDK resolves conflicts in that list by file name, whatever the
       folder, so files added before it are weighed against the engine's own (Serilog.dll, say), which can then be left
       out of the publish root. Added after it, they only ever go under plugins/InfoPanel.Extras/. -->
  <Target Name="PublishBundledPlugins" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="BuildBundledPlugins">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BundledPluginFile)" RelativePath="%(_BundledPluginFile.RelativePath)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- The sensor helper (InfoPanel.SensorHelper, which hosts LibreHardwareMonitorLib for the Libre source): a publish for
       a Windows runtime (dotnet publish -r win-x64), self-contained or not, publishes it for that runtime, framework-
       dependent whatever the engine is (it rolls forward to an installed .NET), and puts it in its own folder,
       sensor-helper\ beside the engine, where the engine starts it (sensor-helper\InfoPanel.SensorHelper.exe, with its
       own deps and runtimeconfig files; LibreHelperProcess.DefaultPath). Its own folder, because in a self-contained
       publish the helper's apphost would find the engine's hostfxr.dll beside it, take that folder for its .NET and fail,
       and because the two carry some of the same assemblies (System.Threading.AccessControl.dll), which can't share a
       folder. Only then: LibreHardwareMonitorLib's assemblies exist only for Windows runtimes, so a build, or a publish
       for any other runtime, carries no helper (the Libre source then says helperFailed). Restored with the engine for
       that runtime, as the bundled plugin is, and published into the engine's intermediate folder first; added to the
       publish list after it is computed, as the bundled plugin's files are. -->
  <PropertyGroup>
    <_PublishesSensorHelper Condition="$(RuntimeIdentifier.StartsWith('win-'))">true</_PublishesSensorHelper>
  </PropertyGroup>

  <Target Name="RestoreSensorHelper" AfterTargets="Restore" Condition="'$(_PublishesSensorHelper)' == 'true'">
    <MSBuild Projects="..\InfoPanel.SensorHelper\InfoPanel.SensorHelper.csproj" Targets="Restore"
             Properties="RuntimeIdentifier=$(RuntimeIdentifier)" RemoveProperties="TargetFramework;SelfContained;PublishDir;NoBuild" />
  </Target>

  <Target Name="PublishSensorHelper" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(_PublishesSensorHelper)' == 'true'">
    <!-- In the target: the intermediate folder is only known once the SDK's targets are evaluated. -->
    <PropertyGroup>
      <_SensorHelperPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'sensor-helper'))</_SensorHelperPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\InfoPanel.SensorHelper\InfoPanel.SensorHelper.csproj" Targets="Publish"
             Properties="RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;Configuration=$(Configuration);PublishDir=$(_SensorHelperPublishDir)"
             RemoveProperties="TargetFramework;NoBuild" />
    <ItemGroup>
      <_SensorHelperFile Include="$(_SensorHelperPublishDir)**\*" Exclude="$(_SensorHelperPublishDir)**\*.pdb" />
      <ResolvedFileToPublish Include="@(_SensorHelperFile)" RelativePath="sensor-helper$([System.IO.Path]::DirectorySeparatorChar)%(_SensorHelperFile.RecursiveDir)%(_SensorHelperFile.Filename)%(_SensorHelperFile.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- The engine's build, which GET /api/session reports (engineBuild): EngineBuild.targets records it. -->
  <Import Project="EngineBuild.targets" />

  <!-- The web client origin a release build carries (InfoPanelAllowOrigin; none by default): WebClientOrigin.targets. -->
  <Import Project="WebClientOrigin.targets" />

</Project>
